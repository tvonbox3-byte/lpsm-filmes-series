<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" />
    <Button android:id="@+id/screenBtn"
        android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_gravity="top|end" android:layout_margin="12dp"
        android:text="AJUSTAR TELA" android:contentDescription="Ajustar formato do vídeo"
        android:focusable="true" android:background="@drawable/nav_button_bg"
        android:textColor="@color/text" />
</FrameLayout>
