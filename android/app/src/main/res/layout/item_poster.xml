<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/focus_bg" android:padding="5dp" android:focusable="true" android:layout_margin="6dp">
    <ImageView android:id="@+id/poster" android:layout_width="match_parent" android:layout_height="230dp" android:scaleType="centerCrop" />
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="54dp" android:maxLines="2"
        android:ellipsize="end" android:textColor="@color/text" android:textSize="15sp" android:gravity="center_vertical" />
</LinearLayout>
